  <!-- ============================================================
       Actuators: position-controlled, per-joint ctrlrange matching
       the joint mechanical limits. RL env should still normalize
       to [-1, 1] in software for cleaner policy outputs.
       ============================================================ -->
  <actuator>
    <position name="lf_shoulder" joint="left-front-shoulder-joint"  ctrlrange="-1.5708 1.6"/>
    <position name="lf_knee"     joint="left-front-knee-joint"      ctrlrange="-1.22 1.49"/>
    <position name="lb_shoulder" joint="left-back-shoulder-joint"   ctrlrange="-1.5708 1.6"/>
    <position name="lb_knee"     joint="left-back-knee-joint"       ctrlrange="-1.22 1.49"/>
    <position name="rb_shoulder" joint="right-back-shoulder-joint"  ctrlrange="-1.5708 1.6"/>
    <position name="rb_knee"     joint="right-back-knee-joint"      ctrlrange="-1.22 1.49"/>
    <position name="rf_shoulder" joint="right-front-shoulder-joint" ctrlrange="-1.5708 1.6"/>
    <position name="rf_knee"     joint="right-front-knee-joint"     ctrlrange="-1.22 1.49"/>
  </actuator>

  <!-- ============================================================
       Sensors: enough for typical quadruped RL.
       Joint angles + velocities give proprioception.
       Orientation + gyro + accelerometer give full IMU.
       framepos / framelinvel give body state for reward shaping.
       ============================================================ -->
  <sensor>
    <!-- proprioception -->
    <jointpos name="lf_shoulder_pos" joint="left-front-shoulder-joint"/>
    <jointpos name="lf_knee_pos"     joint="left-front-knee-joint"/>
    <jointpos name="lb_shoulder_pos" joint="left-back-shoulder-joint"/>
    <jointpos name="lb_knee_pos"     joint="left-back-knee-joint"/>
    <jointpos name="rb_shoulder_pos" joint="right-back-shoulder-joint"/>
    <jointpos name="rb_knee_pos"     joint="right-back-knee-joint"/>
    <jointpos name="rf_shoulder_pos" joint="right-front-shoulder-joint"/>
    <jointpos name="rf_knee_pos"     joint="right-front-knee-joint"/>

    <jointvel name="lf_shoulder_vel" joint="left-front-shoulder-joint"/>
    <jointvel name="lf_knee_vel"     joint="left-front-knee-joint"/>
    <jointvel name="lb_shoulder_vel" joint="left-back-shoulder-joint"/>
    <jointvel name="lb_knee_vel"     joint="left-back-knee-joint"/>
    <jointvel name="rb_shoulder_vel" joint="right-back-shoulder-joint"/>
    <jointvel name="rb_knee_vel"     joint="right-back-knee-joint"/>
    <jointvel name="rf_shoulder_vel" joint="right-front-shoulder-joint"/>
    <jointvel name="rf_knee_vel"     joint="right-front-knee-joint"/>

    <!-- IMU at root site -->
    <framequat    name="imu_orientation" objtype="site" objname="imu"/>
    <gyro         name="imu_gyro"         site="imu"/>
    <accelerometer name="imu_accel"       site="imu"/>

    <!-- Body state (useful for forward-velocity rewards) -->
    <framepos     name="root_pos"     objtype="site" objname="imu"/>
    <framelinvel  name="root_linvel"  objtype="site" objname="imu"/>

    <!-- Foot world positions, for the feet_air_time reward's contact test. Present for
         mj_vec_env.py: mujoco.rollout returns sensordata for the whole batch alongside the state,
         so reading foot height from a sensor costs nothing, whereas geom_xpos would need a
         separate per-env mj_forward. The sites sit at the foot spheres' centres, so a foot is in
         contact when its z is below (radius + a small margin) - see FEET_CONTACT_HEIGHT_THRESHOLD.
         Nothing indexes sensordata positionally, so appending here is safe. -->
    <framepos name="left_back_foot_pos"   objtype="site" objname="left_back_foot"/>
    <framepos name="left_front_foot_pos"  objtype="site" objname="left_front_foot"/>
    <framepos name="right_back_foot_pos"  objtype="site" objname="right_back_foot"/>
    <framepos name="right_front_foot_pos" objtype="site" objname="right_front_foot"/>

    <!-- Actuator force, for the `power` reward's mechanical-power term (sum |tau * qdot|).
         Read from a sensor rather than recomputed as kp*(target-q) - kv*qdot because both
         gains are domain-randomised per environment (mj_vec_env randomises actuator_gainprm
         and actuator_biasprm together) and forcerange is randomised separately, so an
         analytic copy would have to track three DR paths to stay correct. MuJoCo already
         applies the clamp. Order matches the actuator block above, not joint DFS order.
         As with the foot sensors, nothing indexes sensordata positionally. -->
    <actuatorfrc name="lf_shoulder_frc" actuator="lf_shoulder"/>
    <actuatorfrc name="lf_knee_frc"     actuator="lf_knee"/>
    <actuatorfrc name="lb_shoulder_frc" actuator="lb_shoulder"/>
    <actuatorfrc name="lb_knee_frc"     actuator="lb_knee"/>
    <actuatorfrc name="rb_shoulder_frc" actuator="rb_shoulder"/>
    <actuatorfrc name="rb_knee_frc"     actuator="rb_knee"/>
    <actuatorfrc name="rf_shoulder_frc" actuator="rf_shoulder"/>
    <actuatorfrc name="rf_knee_frc"     actuator="rf_knee"/>
  </sensor>

  <!-- ============================================================
       Keyframe: standing pose. qpos layout is
         [x y z  qw qx qy qz   8 joint angles in DFS order]
       Joint order (DFS from root):
         lb_shoulder, lb_knee,  lf_shoulder, lf_knee,
         rb_shoulder, rb_knee,  rf_shoulder, rf_knee
       0.56 rad ~ 32 deg, all legs symmetric.

       Base z: forward kinematics puts the lowest toe 0.09436 below
       the base at this joint configuration, and settling under gravity gives 0.09382 (~0.3mm of
       contact penetration); 0.0938 starts the robot in equilibrium instead of dropping on every
       reset. 0.085 was close but not exact - it predates any of this being measured.

       An intermediate revision of this file set 0.0533 here. That was wrong, and came from
       putting the foot spheres 4cm up the shin (see the footL/footR comment): the robot stood on
       its knees, and every height-dependent constant got dragged down with it. If you see 0.0533
       anywhere, it belongs to that mistake.

       Anything comparing against this height must move with it - pio.BASE_HEIGHT_TARGET, the
       env cfgs' base_init_pos / base_height_target. The base_height reward scale is -50, so a
       stale target dominates the return.
       ============================================================ -->
  <keyframe>
    <key name="home"
         qpos="0 0 0.0941  1 0 0 0
               0.56 0.56  0.56 0.56  0.56 0.56  0.56 0.56"
         ctrl="0.56 0.56 0.56 0.56 0.56 0.56 0.56 0.56"/>
  </keyframe>
</mujoco>